{
	"name": "PL_Master_Orchestrator",
	"properties": {
		"activities": [
			{
				"name": "Get Active Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "control.sp_GetTableLoadOrder",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_ControlDB",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach Table",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Active Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Active Tables').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Check Load Type",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().initial_load_completed, 0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Exec Incremental Load",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "PL_Incremental_CDC_Single_Table",
												"type": "PipelineReference"
											},
											"parameters": {
												"pipeline_run_id": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												},
												"table_metadata": {
													"value": "@item()",
													"type": "Expression"
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Exec Initial Load",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "PL_Initial_Load_Single_Table",
												"type": "PipelineReference"
											},
											"parameters": {
												"pipeline_run_id": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												},
												"table_metadata": {
													"value": "@item()",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}