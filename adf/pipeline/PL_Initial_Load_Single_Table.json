{
	"name": "PL_Initial_Load_Single_Table",
	"properties": {
		"activities": [
			{
				"name": "Copy Full Table",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_AzureSQL_Source",
						"type": "DatasetReference",
						"parameters": {
							"serverName": "adf-databricks.database.windows.net",
							"databaseName": "ADF-Databricks",
							"schemaName": "@pipeline().parameters.table_metadata.schema_name",
							"tableName": "@pipeline().parameters.table_metadata.table_name"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Parquet_Bronze",
						"type": "DatasetReference",
						"parameters": {
							"source_system": "AzureSQL",
							"schema_name": "@pipeline().parameters.table_metadata.schema_name",
							"table_name": "@pipeline().parameters.table_metadata.table_name",
							"load_type": "initial",
							"pipeline_run_id": "@pipeline().parameters.pipeline_run_id"
						}
					}
				]
			},
			{
				"name": "NB Initial Load Dynamic",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Copy Full Table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/bronze/Initial_Load_Dynamic",
					"baseParameters": {
						"pipeline_run_id": {
							"value": "@pipeline().parameters.pipeline_run_id",
							"type": "Expression"
						},
						"table_id": {
							"value": "@string(pipeline().parameters.table_metadata.table_id)",
							"type": "Expression"
						},
						"source_system": "AzureSQL",
						"schema_name": {
							"value": "@pipeline().parameters.table_metadata.schema_name",
							"type": "Expression"
						},
						"table_name": {
							"value": "@pipeline().parameters.table_metadata.table_name",
							"type": "Expression"
						},
						"primary_key_columns": {
							"value": "@pipeline().parameters.table_metadata.primary_key_columns",
							"type": "Expression"
						},
						"sql_server": "adf-databricks.database.windows.net",
						"sql_database": "ADF-Databricks",
						"sql_username": "{{PLACEHOLDER_SQL_USERNAME}}",
						"sql_password": "{{PLACEHOLDER_SQL_PASSWORD}}",
						"storage_account": "adfdatabricks456"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"pipeline_run_id": {
				"type": "string"
			},
			"table_metadata": {
				"type": "object"
			}
		},
		"annotations": []
	}
}