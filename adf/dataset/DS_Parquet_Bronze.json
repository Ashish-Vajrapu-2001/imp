{
    "name": "DS_Parquet_Bronze",
    "properties": {
        "type": "Parquet",
        "linkedServiceName": { "referenceName": "LS_AzureDataLakeStorage", "type": "LinkedServiceReference" },
        "parameters": {
            "source_system": { "type": "string" },
            "schema_name": { "type": "string" },
            "table_name": { "type": "string" },
            "load_type": { "type": "string" },
            "pipeline_run_id": { "type": "string" }
        },
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "folderPath": {
                    "value": "bronze/@{dataset().source_system}/@{dataset().schema_name}/@{dataset().table_name}/@{dataset().load_type}/@{dataset().pipeline_run_id}",
                    "type": "Expression"
                },
                "fileSystem": "datalake"
            }
        }
    }
}
