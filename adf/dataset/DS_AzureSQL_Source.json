            }
        },
        "parameters": {
            "serverName": { "type": "string" },
            "databaseName": { "type": "string" },
            "schemaName": { "type": "string" },
            "tableName": { "type": "string" }
        },
        "type": "AzureSqlTable",
        "schema": [],
        "typeProperties": {
            "schema": "@dataset().schemaName",
            "table": "@dataset().tableName"
        }
    }
}
